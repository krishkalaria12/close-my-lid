{
  "name": "close-my-lid-monorepo",
  "private": true,
  "version": "0.5.1",
  "description": "Close My Lid monorepo: native menu bar app for macOS, CLI and tray app for Linux and Windows, Raycast extension, and marketing site.",
  "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @close-my-lid/web dev",
    "build": "pnpm --filter @close-my-lid/web build",
    "preview": "pnpm --filter @close-my-lid/web preview",
    "web:dev": "pnpm --filter @close-my-lid/web dev",
    "web:build": "pnpm --filter @close-my-lid/web build",
    "raycast:dev": "npm --prefix packages/raycast run dev",
    "raycast:build": "npm --prefix packages/raycast run build",
    "raycast:lint": "npm --prefix packages/raycast run lint",
    "desktop:build": "cargo build --manifest-path apps/desktop/Cargo.toml",
    "desktop:test": "cargo test --manifest-path apps/desktop/Cargo.toml -p lidcore -p lid-macos -p lid-cli",
    "macos:build": "cargo build --manifest-path apps/desktop/Cargo.toml -p lid-macos",
    "macos:test": "cargo test --manifest-path apps/desktop/Cargo.toml -p lidcore -p lid-macos",
    "macos:package": "./scripts/package-macos-app.sh"
  }
}
